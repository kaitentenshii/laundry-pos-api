APP_ENV=development
PORT=8080
SHUTDOWN_TIMEOUT=10s
DATABASE_CONNECT_TIMEOUT=5s
MIGRATIONS_PATH=file://migrations
AUTH_SESSION_TTL=8h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Replace these development placeholders before starting PostgreSQL.
POSTGRES_DB=laundry_pos
POSTGRES_USER=laundry_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://laundry_user:change-me@localhost:5432/laundry_pos?sslmode=disable

